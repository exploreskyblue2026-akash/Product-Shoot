# Copy to .env for local runs. On Railway, add these under the service's Variables tab.
SECRET_KEY=generate-a-long-random-string
OWNER_EMAIL=you@skybluestationery.com
OWNER_PASSWORD=choose-a-strong-password
# DATABASE_URL is set automatically when you add Railway Postgres (use ${{Postgres.DATABASE_URL}})
DATABASE_URL=
# Mount a Railway volume at /data and point storage there so images survive redeploys
STORAGE_DIR=/data
AI_PROVIDER=gemini
GEMINI_API_KEY=
MODEL_VISION=gemini-2.5-flash
MODEL_IMAGE_PRO=gemini-3-pro-image-preview
MODEL_IMAGE_FAST=gemini-3.1-flash-image-preview
IMAGE_SIZE=2K
# Google service account JSON on one line (Drive + Sheets access)
GOOGLE_SERVICE_ACCOUNT_JSON=
OUTPUT_DRIVE_FOLDER_ID=
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-07
RUN_WORKER=true
WATCH_INTERVAL_MIN=30
COOKIE_SECURE=true
